    "def iqr_capping(dataframe, kolom):\n",
    "    Q1 = dataframe[kolom].quantile(0.25)\n",
    "    Q3 = dataframe[kolom].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "\n",
    "    sebelum = ((dataframe[kolom] < lower) | (dataframe[kolom] > upper)).sum()\n",
    "    dataframe[kolom] = dataframe[kolom].clip(lower=lower, upper=upper)\n",
    "    sesudah = ((dataframe[kolom] < lower) | (dataframe[kolom] > upper)).sum()\n",
    "\n",
    "    print(f\"Kolom: {kolom}\")\n",
    "    print(f\"Batas bawah: {lower:.2f}\")\n",
    "    print(f\"Batas atas : {upper:.2f}\")\n",
    "    print(f\"Outlier sebelum capping: {sebelum}\")\n",
    "    print(f\"Outlier setelah capping : {sesudah}\")\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "for kolom in [\"harga_juta\", \"luas_m2\", \"tahun_bangun\"]:\n",
    "    iqr_capping(df, kolom)\n",
    "\n",
    "df.describe()\n"
   ]
  },
