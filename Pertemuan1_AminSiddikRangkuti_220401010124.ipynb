            "Status: Lulus dengan baik\n"
          ]
        }
      ],
      "source": [
        "nilai_akhir = 85\n",
        "\n",
        "if nilai_akhir >= 80:\n",
        "    status = \"Lulus dengan baik\"\n",
        "elif nilai_akhir >= 60:\n",
        "    status = \"Lulus\"\n",
        "else:\n",
        "    status = \"Tidak lulus\"\n",
        "\n",
        "print(\"Nilai akhir:\", nilai_akhir)\n",
        "print(\"Status:\", status)"
      ]
