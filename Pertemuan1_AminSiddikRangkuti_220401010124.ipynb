        "# 7. Perulangan For\n",
        "\n",
        "Perulangan digunakan untuk menjalankan kode secara berulang. Pada contoh ini digunakan untuk menampilkan semua nilai dalam list."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 25,
      "id": "4435b2d3",
      "metadata": {
        "id": "4435b2d3",
        "outputId": "22cb2bae-f654-4d07-8813-bcac80842010",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Nilai ke-1: 80\n",
            "Nilai ke-2: 85\n",
            "Nilai ke-3: 90\n",
            "Nilai ke-4: 75\n",
            "Nilai ke-5: 88\n"
          ]
        }
      ],
      "source": [
        "daftar_nilai = [80, 85, 90, 75, 88]\n",
        "\n",
        "for i, nilai_mahasiswa in enumerate(daftar_nilai, start=1):\n",
        "    print(f\"Nilai ke-{i}: {nilai_mahasiswa}\")"
      ]
    },
