          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Daftar nilai: [80, 85, 90, 75, 88]\n",
            "Rata-rata nilai: 83.6\n"
          ]
        }
      ],
      "source": [
        "def hitung_rata_rata(data):\n",
        "    return sum(data) / len(data)\n",
